generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Supporter gives. Creator shares good-deed videos and receives the net.
/// Moderator and admin review reports. One person is one account (unique email, unique phone, later KYC subject).
enum Role {
  SUPPORTER
  CREATOR
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ModerationStatus {
  VISIBLE
  FLAGGED
  HIDDEN
  REMOVED
}

/// PENDING waits for Stripe. HELD is paid and inside the payout hold.
/// AVAILABLE has cleared the hold. PAID_OUT is reserved for a real payout provider.
enum LedgerStatus {
  PENDING
  HELD
  AVAILABLE
  PAID_OUT
  FAILED
  REFUNDED
  /// Creator share is held for a refund or dispute. It is not payable and it is not a negative balance.
  FROZEN
}

enum PaymentMode {
  DEMO
  STRIPE
  CREDITS
}

enum DonationKind {
  GIFT
  CIRCLE
  FAMILY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(SUPPORTER)
  locale       String   @default("sk")
  /// True only after the person chooses a language. Device detection does not set this.
  localeChosen Boolean @default(false)
  /// Self-declared "I am 18 or older". This is not an identity or age-provider check.
  adultAttestedAt DateTime?
  phone        String?  @unique
  /// Filled by a future KYC provider (Smile ID or similar). Null until then.
  kycSubjectId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creatorProfile    CreatorProfile?
  blessings         Blessing[]
  comments          Comment[]
  donations         LedgerTransaction[] @relation("DonorTransactions")
  reports           Report[]
  auditLogs         AuditLog[]
  familyMemberships FamilyMembership[]  @relation("SupporterFamily")
  liveMessages      LiveMessage[]
  blocksGiven       UserBlock[]         @relation("BlocksGiven")
  blocksReceived    UserBlock[]         @relation("BlocksReceived")
  creditEntries     CreditEntry[]
  accountReviews    AccountReview[]
  followsOut        Follow[]           @relation("FollowsOut")
  followsIn         Follow[]           @relation("FollowsIn")
  creatorUpdates    CreatorUpdate[]
  notesSent         Encouragement[]    @relation("EncouragementFrom")
  notesReceived     Encouragement[]    @relation("EncouragementTo")
  liveInvites       LiveInvite[]
  topicPreferences  TopicPreference[]
  feedHides         FeedHide[]
  feedTaste         FeedTaste?
}

model CreatorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String             @unique
  displayName        String
  bio                String
  bioEn              String?
  city               String
  countryCode        String             @default("KE")
  avatarUrl          String
  craftKey           String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  /// Future provider id, for example "smile_id".
  kycProvider        String?
  kycReference       String?
  /// Stripe Connect account. When set, charges use application_fee_amount + transfer_data.
  stripeAccountId    String?
  payoutProvider     String             @default("stub")
  payoutDestination  String?
  payoutHoldDays     Int                @default(7)
  createdAt          DateTime           @default(now())

  videos         Video[]
  allocations    LedgerAllocation[]
  circlesHosted  BlessingCircle[]   @relation("CircleHost")
  participations CircleParticipant[]
  familyMembers  FamilyMembership[] @relation("CreatorFamily")
  payouts        PayoutRequest[]
  hostedLive     LiveSession[]
  payoutHolds    PayoutReservation[]
  feedHides      FeedHide[]
}

model Video {
  id               String           @id @default(cuid())
  creatorId        String
  creator          CreatorProfile   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title            String
  titleEn          String?
  caption          String
  captionEn        String?
  storageKey       String
  playbackUrl      String
  posterUrl        String?
  durationSec      Int              @default(8)
  deedKind         String
  /// Language of the picture and the words. Not a device location.
  language         String           @default("en")
  circleId         String?
  circle           BlessingCircle?  @relation(fields: [circleId], references: [id])
  moderationStatus ModerationStatus @default(VISIBLE)
  consentConfirmed Boolean          @default(false)
  rulesVersion     Int              @default(1)
  createdAt        DateTime         @default(now())

  blessings    Blessing[]
  comments     Comment[]
  transactions LedgerTransaction[]

  @@index([moderationStatus, createdAt])
  @@index([deedKind, createdAt])
  @@index([creatorId, createdAt])
}

model Blessing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
}

model Comment {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId          String
  video            Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  body             String
  moderationStatus ModerationStatus @default(VISIBLE)
  moderationNote   String?
  createdAt        DateTime         @default(now())
}

model Gift {
  id           String              @id @default(cuid())
  slug         String              @unique
  nameSk       String
  nameEn       String
  priceCents   Int
  symbol       String
  sortOrder    Int                 @default(0)
  transactions LedgerTransaction[]
}

/// One donor charge. grossCents is the amount paid.
/// feeCents is the platform share (15%). netCents is what creators share (85%).
/// feeCents + netCents = grossCents is also enforced in SQL.
model LedgerTransaction {
  id                    String        @id @default(cuid())
  donorId               String
  donor                 User          @relation("DonorTransactions", fields: [donorId], references: [id])
  videoId               String?
  video                 Video?        @relation(fields: [videoId], references: [id])
  circleId              String?
  circle                BlessingCircle? @relation(fields: [circleId], references: [id])
  giftId                String?
  gift                  Gift?         @relation(fields: [giftId], references: [id])
  kind                  DonationKind
  grossCents            Int
  feeCents              Int
  netCents              Int
  currency              String        @default("usd")
  status                LedgerStatus
  paymentMode           PaymentMode
  stripePaymentIntentId String?       @unique
  anonymous             Boolean       @default(false)
  payItForwardFromId    String?
  payItForwardFrom      LedgerTransaction?  @relation("PayItForward", fields: [payItForwardFromId], references: [id])
  forwards              LedgerTransaction[] @relation("PayItForward")
  familyMembershipId    String?
  familyMembership      FamilyMembership? @relation(fields: [familyMembershipId], references: [id])
  holdUntil             DateTime?
  note                  String?
  /// Demo or unconfigured-Stripe value. Never payable, even after the hold date.
  sandbox               Boolean           @default(false)
  liveSessionId         String?
  liveSession           LiveSession?  @relation(fields: [liveSessionId], references: [id])
  createdAt             DateTime      @default(now())

  allocations LedgerAllocation[]
  moneyEvents MoneyEvent[]
  payoutHolds PayoutReservation[]

  @@index([donorId, createdAt])
  @@index([circleId])
  @@index([status, holdUntil])
  @@index([liveSessionId])
}

/// A creator's share of a transaction's net. Circle gifts have one row per verified participant.
model LedgerAllocation {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       CreatorProfile    @relation(fields: [creatorId], references: [id])
  netCents      Int
  createdAt     DateTime          @default(now())

  @@index([creatorId])
}

model FamilyMembership {
  id           String   @id @default(cuid())
  supporterId  String
  supporter    User     @relation("SupporterFamily", fields: [supporterId], references: [id], onDelete: Cascade)
  creatorId    String
  creator      CreatorProfile @relation("CreatorFamily", fields: [creatorId], references: [id], onDelete: Cascade)
  monthlyCents Int
  anonymous    Boolean  @default(false)
  status       String   @default("ACTIVE")
  nextChargeAt DateTime?
  createdAt    DateTime @default(now())

  charges LedgerTransaction[]

  @@unique([supporterId, creatorId])
}

model BlessingCircle {
  id            String   @id @default(cuid())
  hostId        String
  host          CreatorProfile @relation("CircleHost", fields: [hostId], references: [id])
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())

  participants CircleParticipant[]
  videos       Video[]
  transactions LedgerTransaction[]
  liveSessions LiveSession[]
}

model CircleParticipant {
  id        String         @id @default(cuid())
  circleId  String
  circle    BlessingCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  joinedAt  DateTime       @default(now())

  @@unique([circleId, creatorId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  targetType String
  targetId   String
  reason     String
  details    String?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model LiveSession {
  id        String    @id @default(cuid())
  roomName  String    @unique
  hostId    String
  host      CreatorProfile @relation(fields: [hostId], references: [id])
  circleId  String?
  circle    BlessingCircle? @relation(fields: [circleId], references: [id])
  title     String
  status    String    @default("LIVE")
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  messages     LiveMessage[]
  transactions LedgerTransaction[]
  invites      LiveInvite[]

  @@index([status, startedAt])
}

model LiveMessage {
  id               String           @id @default(cuid())
  sessionId        String
  session          LiveSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  body             String
  moderationStatus ModerationStatus @default(VISIBLE)
  moderationNote   String?
  createdAt        DateTime         @default(now())

  @@index([sessionId, createdAt])
}

model UserBlock {
  id         String   @id @default(cuid())
  blockerId  String
  blockedId  String
  blocker    User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
}

/// Supporter lights (svetielka). amount is positive for a pack and negative for a gift.
/// The balance is the sum. A gift spend also writes the 15/85 ledger row.
model CreditEntry {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                  Int
  kind                    String
  packSlug                String?
  idempotencyKey          String   @unique
  stripeCheckoutSessionId String?  @unique
  stripePaymentIntentId   String?  @unique
  ledgerTransactionId     String?  @unique
  createdAt               DateTime @default(now())

  @@index([userId, createdAt])

  allocations CreditAllocation[] @relation("PackAllocations")
  releases    CreditRelease[] @relation("PackReleases")
}

/// Immutable note of a monetary fact. Amounts on LedgerTransaction are not a second ledger.
model MoneyEvent {
  id            String             @id @default(cuid())
  transactionId String?
  transaction   LedgerTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  kind          String
  grossCents    Int
  feeCents      Int
  netCents      Int
  stripeEventId String?            @unique
  note          String?
  createdAt     DateTime           @default(now())

  @@index([transactionId])
}

/// One row per Stripe event id. A replay finds this row and does not move money again.
model WebhookDelivery {
  id        String   @id
  eventType String
  outcome   String
  createdAt DateTime @default(now())
}

/// Notices that can arrive before the credit or the gift row exists.
model PaymentMarker {
  key       String   @id
  kind      String
  createdAt DateTime @default(now())
}

/// Spent lights that cannot be pulled back without driving a balance below zero.
model AccountReview {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  packEntryId   String?
  kind          String
  reversedCents Int
  frozenCents   Int
  reviewCents   Int
  stripeEventId String?  @unique
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())

  @@index([userId, status])
}

/// Which pack lot funded a spend, or which unspent lights a reversal consumed.
model CreditAllocation {
  id               String   @id @default(cuid())
  packEntryId      String
  packEntry        CreditEntry @relation("PackAllocations", fields: [packEntryId], references: [id], onDelete: Restrict)
  spendEntryId     String?
  reversalEntryId  String?
  lights           Int
  createdAt        DateTime @default(now())

  @@index([packEntryId])
  @@index([spendEntryId])
}

/// Gives unspent lights back to a lot after a dispute is won. Append-only.
model CreditRelease {
  id             String   @id @default(cuid())
  packEntryId    String
  packEntry      CreditEntry @relation("PackReleases", fields: [packEntryId], references: [id], onDelete: Restrict)
  lights         Int
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([packEntryId])
}

/// Holds part of a creator's payout. A large gift can be reserved in part.
model PayoutReservation {
  id             String          @id @default(cuid())
  creatorId      String
  creator        CreatorProfile  @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  transactionId  String?
  transaction    LedgerTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  packEntryId    String
  amountCents    Int
  status         String          @default("ACTIVE")
  generation     Int
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())

  @@index([creatorId, status])
  @@index([packEntryId, status])
}

/// Provider state for one checkout. Stops a refund and a won dispute from both restoring lights.
model PaymentCase {
  id               String   @id @default(cuid())
  sessionId        String?  @unique
  paymentIntentId  String?  @unique
  userId           String?
  packEntryId      String?
  refunded         Boolean  @default(false)
  held             Boolean  @default(false)
  restored         Boolean  @default(false)
  dispute          String?
  generation       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Shared limit for financial actions. The key is action plus user id, not a device fingerprint.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model PayoutRequest {
  id          String         @id @default(cuid())
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String         @default("usd")
  provider    String
  status      String
  reference   String?
  createdAt   DateTime       @default(now())
}

/// One row per supporter and creator. A second follow does not create a second row.
model Follow {
  id         String   @id @default(cuid())
  followerId String
  creatorId  String
  createdAt  DateTime @default(now())
  follower   User     @relation("FollowsOut", fields: [followerId], references: [id], onDelete: Cascade)
  creator    User     @relation("FollowsIn", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([followerId, creatorId])
  @@index([creatorId])
}

/// In-app note from a creator. Nothing here sends email, SMS, or a push.
model CreatorUpdate {
  id               String           @id @default(cuid())
  creatorId        String
  creator          User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  body             String
  moderationStatus ModerationStatus @default(VISIBLE)
  createdAt        DateTime         @default(now())

  @@index([creatorId, createdAt])
}

/// Private thanks or a helpful mark. Only the recipient can list these. Not a ranking.
model Encouragement {
  id               String           @id @default(cuid())
  fromUserId       String
  toUserId         String
  fromUser         User             @relation("EncouragementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser           User             @relation("EncouragementTo", fields: [toUserId], references: [id], onDelete: Cascade)
  kind             String
  body             String
  moderationStatus ModerationStatus @default(VISIBLE)
  createdAt        DateTime         @default(now())

  @@index([toUserId, createdAt])
}

/// Host invite for one extra co-host. Publishing waits for an explicit accept and camera consent.
model LiveInvite {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User        @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  status    String      @default("PENDING")
  consentAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([sessionId, inviteeId])
  @@index([inviteeId, status])
}

/// One row per person and topic. Interested or not. Nothing here is a payment.
model TopicPreference {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic      String
  interested Boolean
  createdAt  DateTime @default(now())

  @@unique([userId, topic])
  @@index([userId])
}

/// Hides one creator from this person's feed. Separate from a block.
model FeedHide {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, creatorId])
  @@index([userId])
}

/// Optional language list and a country, never a precise location.
model FeedTaste {
  userId     String  @id
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  languages  String[]
  regionCode String?
}
