    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@livekit/components-react": "^2.9.24",
    "@prisma/client": "^6.18.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.10.0",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
