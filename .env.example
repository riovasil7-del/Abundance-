# Postgres. On Neon or Supabase use the pooled string here.
# Local example:
DATABASE_URL="postgresql://hojnost:hojnost@localhost:5432/hojnost?schema=public"

# Direct connection for Prisma migrations. On Neon this is the non-pooled string.
# Locally it can be the same as DATABASE_URL.
DIRECT_URL="postgresql://hojnost:hojnost@localhost:5432/hojnost?schema=public"

# Signs the session cookie. Use a long random string. Never share it.
AUTH_SECRET="replace-with-a-long-random-string"

# One-time demo fill from /setup. Leave empty to keep that page from writing.
# Use at least 8 characters. Remove it after the demo data is in.
SEED_SECRET=""

# Payments. Leave both empty to keep demo gifts working (15/85 still runs on the server).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Where uploaded videos go: local | vercel-blob | s3 | r2
# local is the laptop disk. Vercel cannot keep local files, so use vercel-blob, s3, or r2 online.
VIDEO_STORAGE="local"

# Vercel Blob. Create a Blob store on the project and paste the token.
BLOB_READ_WRITE_TOKEN=""

# S3-compatible storage (AWS S3 or Cloudflare R2). Used when VIDEO_STORAGE is s3 or r2.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL viewers use to play the file, with no trailing path.
# Example R2: https://pub-xxxx.r2.dev
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE=""

# LiveKit Cloud or a self-hosted LiveKit server.
# Leave all three empty to show "live is not configured" instead of crashing.
# Cloud example URL: wss://your-project.livekit.cloud
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Days a creator's net stays on hold before a payout can be requested.
PAYOUT_HOLD_DAYS="7"

# Public address of this app. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
