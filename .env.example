# PostgreSQL connection string. The app refuses to guess money or users without it.
DATABASE_URL="postgresql://hojnost:hojnost@localhost:5432/hojnost?schema=public"

# Signs the session cookie. Use a long random string in any shared environment.
AUTH_SECRET="replace-with-a-long-random-string"

# Optional. When unset, gifts settle in an explicit demo payment mode.
# The 15/85 split still runs only on the server.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# local | cloudflare-stream | mux
VIDEO_STORAGE="local"

# Days a creator's net earnings stay on hold before they can be paid out.
PAYOUT_HOLD_DAYS="7"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
